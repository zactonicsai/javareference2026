# Copy to .env and change the passwords:  cp .env.example .env
# .env is git-ignored; never commit real credentials.

# Single source of truth for the Keycloak version: used for the server image
# AND for the Maven dependencies of the provider (see Dockerfile).
KEYCLOAK_VERSION=26.8.2

# Temporary bootstrap admin, only used when the master realm has no admin yet.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-db

# Host ports (bound to 127.0.0.1 only).
KEYCLOAK_PORT=8080
MAILPIT_PORT=8025
